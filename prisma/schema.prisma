generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Authorization role. Assigned deliberately (never chosen at registration);
// new users default to `student`. `admin` can create/edit/delete dialogs.
enum Role {
  student
  admin
}

// Node-native user for authentication (bcrypt password hash + JWT sessions).
// `name` is the login username: unique and required (no email).
model User {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  passwordHash  String
  role          Role           @default(student)
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
}

// A device's long-lived sign-in for the student app (see src/refreshTokens.ts).
// Only a hash of the token is stored. Each refresh marks the token used and
// issues a new one in the same family (one family per sign-in on a device);
// reusing an already-used token revokes the whole family.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([familyId])
  @@index([userId])
}

model Level {
  id          Int     @id @default(autoincrement())
  name        String
  levelNumber Int     @map("level_number")
  description String? // optional free-form description of the level
  units       Unit[] // back-relation: one Level has many Units (no DB column)
}

model Unit {
  id          Int         @id @default(autoincrement())
  name        String
  unitNumber  Int         @map("unit_number")
  description String? // optional free-form description of the unit
  lecture     String? // optional lecture content for the unit
  levelId     Int         @map("level_id") // FK column → Level.id
  level       Level       @relation(fields: [levelId], references: [id])
  itemGroups  ItemGroup[] // back-relation: one Unit has many ItemGroups (no DB column)
}

// What kind of items an ItemGroup holds.
enum ItemType {
  text
  question
}

// How an ItemGroup's items are presented.
enum ItemDisplayType {
  scrolling // all items on one scrolling page
  individual_screen // one item per screen
}

model ItemGroup {
  id              Int              @id @default(autoincrement())
  itemGroupNumber Int              @map("item_group_number")
  description     String? // optional free-form description of the item group
  displayType     ItemDisplayType? @map("display_type") // optional: how the group's items are displayed
  itemType        ItemType?        @map("item_type") // what kind of items the group holds
  unitId          Int              @map("unit_id") // FK column → Unit.id
  unit            Unit             @relation(fields: [unitId], references: [id])
  questionItems   QuestionItem[] // back-relation: one ItemGroup has many QuestionItems (no DB column)
  textItems       TextItem[] // back-relation: one ItemGroup has many TextItems (no DB column)
}

model QuestionItem {
  id                         Int       @id @default(autoincrement())
  itemNumber                 Int       @map("item_number")
  questionText               String?   @map("question_text") // the question
  questionPrompt             String?   @map("question_prompt") // optional prompt/instruction shown with the question
  answerKey                  String?   @map("answer_key") // the correct answer
  choices                    String? // answer options, if the question has any
  format                     Int       @default(1) // which question format/layout to use
  explanation                String? // optional: why the answer is correct, shown to the student
  showExplanationWhenCorrect Boolean   @default(false) @map("show_explanation_when_correct") // also show the explanation after a correct answer (by default only after a wrong one)
  media                      String? // optional text with inline media, e.g. images as ![](<public S3 URL>) (the question's audio is in `audio`)
  audio                      String? // optional: public S3 URL of the question's MP3, under question-audios/<item id>/
  audioText                  String?   @map("audio_text") // the text the audio speaks (kept so the voice can be regenerated from it)
  voiceName                  String?   @map("voice_name") // the voice that spoke the audio; mostly ElevenLabs voices (the preferred TTS engine), e.g. River, sometimes Google, e.g. en-US-Chirp3-HD-Charon
  checkOrder                 Boolean   @default(false) @map("check_order") // only applies to question format 8
  itemGroupId                Int       @map("item_group_id") // FK column → ItemGroup.id
  itemGroup                  ItemGroup @relation(fields: [itemGroupId], references: [id])
}

// A block of text in an item group (e.g. a reading passage or a note), shown
// in order by itemNumber.
model TextItem {
  id          Int       @id @default(autoincrement())
  itemNumber  Int       @map("item_number")
  content     String // the text
  media       String? // optional text with inline media, e.g. images as ![](<public S3 URL>)
  itemGroupId Int       @map("item_group_id") // FK column → ItemGroup.id
  itemGroup   ItemGroup @relation(fields: [itemGroupId], references: [id])
}

// Voice-chat call recordings uploaded to S3.
model Recording {
  id           BigInt   @id @default(autoincrement())
  url          String
  s3Key        String
  localPeerId  String
  remotePeerId String
  createdAt    DateTime @default(now())
}

// A standalone block of dialog text (e.g. a conversation script), identified
// by a short title. Not linked to Level/Unit yet — add a relation later if needed.
model Dialog {
  id           Int      @id @default(autoincrement())
  title        String
  text         String
  note         String? // optional free-form note about the dialog
  dialogNumber Int      @map("dialog_number") // admin-assigned ordering number
  createdAt    DateTime @default(now())
}

// Metered TURN credentials this server created (see src/turn.ts). Persisted so a
// restart reuses the live credential instead of minting a new one (the free plan
// caps how many can exist), and so expired ones can be deleted from Metered later.
model TurnCredential {
  username   String   @id // Metered identifies credentials by username (used to delete)
  iceServers Json // what clients receive: TURN URLs + username/password
  createdAt  DateTime @default(now())
  expiresAt  DateTime
}

// ── Dictionary ──────────────────────────────────────────────────────────────
// Copied from the Django app's api/models.py (DictEntry, PartOfSpeech, Sense,
// Idiom, Example). Varchar lengths match Django's CharField max_length; Django
// TextFields are plain text. Deleting a row deletes its children, as Django's
// on_delete=CASCADE does.

// A dictionary headword from one source.
model DictEntry {
  id             Int            @id @default(autoincrement())
  headWord       String         @map("head_word") @db.VarChar(100)
  hyphenated     String         @default("") @db.VarChar(100) // e.g. "dic-tion-ary"
  source         String?        @db.VarChar(60) // e.g. "longman", "ho-ngoc-duc-stardict"
  partOfSpeeches PartOfSpeech[]

  @@unique([headWord, source])
}

// One part of speech of an entry (e.g. noun, verb), with its pronunciations.
model PartOfSpeech {
  id                      Int       @id @default(autoincrement())
  dictEntryId             Int       @map("dict_entry_id") // FK column → DictEntry.id
  dictEntry               DictEntry @relation(fields: [dictEntryId], references: [id], onDelete: Cascade)
  name                    String    @db.VarChar(50)
  pronCode                String?   @map("pron_code") @db.VarChar(50) // British pronunciation code
  amevarPron              String?   @map("amevar_pron") @db.VarChar(50) // American variant pronunciation code
  vietPronCode            String?   @map("viet_pron_code") @db.VarChar(255) // Vietnamese pronunciation (JSON array); the American/flapped form (T -> đ)
  vietPronCodeStandard    String?   @map("viet_pron_code_standard") @db.VarChar(255) // Vietnamese pronunciation (JSON array); the standard/non-flapped form (keeps t)
  vietPronRegionalVariant String    @default("") @map("viet_pron_regional_variant") @db.VarChar(255) // regional variant note
  frequency               String?   @db.VarChar(20)
  grammar                 String?   @db.VarChar(100)
  videoUrl                String?   @map("video_url")
  audioBlob               String    @default("") @map("audio_blob") @db.VarChar(255) // name (without ".mp3") of the pronunciation audio; "" means no audio yet
  senses                  Sense[]
  idioms                  Idiom[]
}

// One meaning of a part of speech.
model Sense {
  id             Int          @id @default(autoincrement())
  posId          Int          @map("pos_id") // FK column → PartOfSpeech.id
  pos            PartOfSpeech @relation(fields: [posId], references: [id], onDelete: Cascade)
  senseNumber    Int          @default(0) @map("sense_number") @db.SmallInt
  definition     String?
  defTranslation String?      @map("def_translation")
  crossReference String?      @map("cross_reference") @db.VarChar(400) // e.g. "be rewarded (with something)/be-rewarded-with-something" (title/head_word)
  grammar        String?      @db.VarChar(80)
  relatedWords   String?      @map("related_words") @db.VarChar(200) // e.g. "run, running, ran"
  examples       Example[]
}

// An idiom under a part of speech.
model Idiom {
  id          Int          @id @default(autoincrement())
  posId       Int          @map("pos_id") // FK column → PartOfSpeech.id
  pos         PartOfSpeech @relation(fields: [posId], references: [id], onDelete: Cascade)
  phrase      String?
  translation String?
}

// An example sentence for a sense.
model Example {
  id              Int     @id @default(autoincrement())
  senseId         Int     @map("sense_id") // FK column → Sense.id
  sense           Sense   @relation(fields: [senseId], references: [id], onDelete: Cascade)
  exampleNumber   Int     @default(0) @map("example_number") @db.SmallInt
  difficultyLevel Int     @default(0) @map("difficulty_level") @db.SmallInt // e.g. 0 for easy … 5 for hard
  sentence        String?
  translation     String?
  grammarPoint    String? @map("grammar_point") @db.VarChar(100) // e.g. "be rewarded (with something)"
}
