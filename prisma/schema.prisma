generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Node-native user for authentication (bcrypt password hash + JWT sessions).
// `name` is the login username: unique and required (no email).
model User {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Level {
  id          Int    @id @default(autoincrement())
  name        String
  levelNumber Int    @map("level_number")
  units       Unit[] // back-relation: one Level has many Units (no DB column)
}

model Unit {
  id         Int    @id @default(autoincrement())
  name       String
  unitNumber Int    @map("unit_number")
  levelId    Int    @map("level_id") // FK column → Level.id
  level      Level  @relation(fields: [levelId], references: [id])
}

// Voice-chat call recordings uploaded to S3.
model Recording {
  id           BigInt   @id @default(autoincrement())
  url          String
  s3Key        String
  localPeerId  String
  remotePeerId String
  createdAt    DateTime @default(now())
}
