generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Node-native user for authentication (bcrypt password hash + JWT sessions).
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
}

model Level {
  id          Int    @id @default(autoincrement())
  name        String
  levelNumber Int    @map("level_number")
}

// Voice-chat call recordings uploaded to S3.
model Recording {
  id           BigInt   @id @default(autoincrement())
  url          String
  s3Key        String
  localPeerId  String
  remotePeerId String
  createdAt    DateTime @default(now())
}
